{
  "$ref": "#/definitions/ConnectorTool",
  "definitions": {
    "ConnectorTool": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "connector_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path_template": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "enum": [
                  "path",
                  "query",
                  "body",
                  "header"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "enum"
                ]
              },
              "description": {
                "type": "string"
              },
              "required": {
                "type": "boolean",
                "default": false
              },
              "enum_values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "location",
              "type"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "body_template": {
          "type": "object",
          "additionalProperties": {}
        },
        "auth_override": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "none"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "api_key"
                },
                "header_name": {
                  "type": "string",
                  "minLength": 1
                },
                "credential_ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "header_name",
                "credential_ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "oauth2_client_credentials"
                },
                "token_url": {
                  "type": "string",
                  "format": "uri"
                },
                "scope": {
                  "type": "string"
                },
                "credential_ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "token_url",
                "credential_ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "basic_auth"
                },
                "credential_ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "credential_ref"
              ],
              "additionalProperties": false
            }
          ]
        },
        "response_mapping": {
          "type": "object",
          "properties": {
            "success_path": {
              "type": "string",
              "minLength": 1
            },
            "template": {
              "type": "string",
              "minLength": 1
            },
            "error_template": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "success_path",
            "template",
            "error_template"
          ],
          "additionalProperties": false
        },
        "timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 30000,
          "default": 8000
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "connector_id",
        "name",
        "description",
        "method",
        "path_template",
        "response_mapping"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

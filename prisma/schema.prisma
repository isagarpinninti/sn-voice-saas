generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// Auth (NextAuth)
// =====================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================================================
// Users & Tenants
// =====================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  tenant        Tenant?
  createdAt     DateTime  @default(now())
}

model Tenant {
  id                String         @id @default(cuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan              Plan           @default(FREE)
  revenuecat_id     String?        @unique
  subscription_id   String?
  plan_expires_at   DateTime?

  minutes_per_month Int            @default(50)
  concurrent_limit  Int            @default(1)
  max_agents        Int            @default(1)
  max_instances     Int            @default(1)

  instances         Instance[]
  tokens            ApiToken[]
  agents            Agent[]
  usageLogs         UsageLog[]
  phoneNumbers      PhoneNumber[]
  allowedCallers    AllowedCaller[]
  attachmentUploads AttachmentUpload[]

  company           String?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

enum Plan {
  FREE
  STARTER
  PRO
  PRO_VOICE
  BUSINESS
  ENTERPRISE
  PREMIUM
}

// =====================================================
// Instances (multi-instance per tenant)
// =====================================================

model Instance {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String   @default("Default Instance")
  snInstanceUrl  String
  snUsername     String
  snPassword     String

  // Widget customization (one widget per instance)
  widgetColor        String?  @default("#10b981")
  widgetPosition     String?  @default("right")
  widgetVoiceOnly    Boolean  @default(false)
  widgetAutoOpen     Boolean  @default(false)
  widgetGreeting     String?
  widgetAgentName    String?
  widgetShowBranding Boolean  @default(true)
  widgetLogoUrl      String?
  widgetBorderRadius String?  @default("full")

  active         Boolean  @default(true)
  agents         Agent[]
  tokens         ApiToken[]
  phoneNumbers   PhoneNumber[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

// =====================================================
// Agents (multi-agent per instance)
// =====================================================

model Agent {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instanceId String?
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  // Identity
  name       String   @default("Default Agent")
  snAgentId  String?

  // Widget customization (per-agent — overrides instance-level settings)
  widgetMode         String?  @default("voice_only")  // voice_only | chat_only | both
  widgetColor        String?
  widgetPosition     String?  @default("right")
  widgetAutoOpen     Boolean  @default(false)
  widgetGreeting     String?
  widgetTitle        String?
  widgetShowBranding Boolean  @default(true)
  widgetLogoUrl      String?
  widgetBorderRadius String?  @default("full")

  active     Boolean  @default(true)
  tokens     ApiToken[]
  phoneNumbers PhoneNumber[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([instanceId])
}

// =====================================================
// API Tokens
// =====================================================

model ApiToken {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  instanceId String?
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  token      String    @unique @default(cuid())
  name       String    @default("Default")
  active     Boolean   @default(true)
  lastUsed   DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([agentId])
  @@index([instanceId])
}

// =====================================================
// Usage Tracking
// =====================================================

model UsageLog {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date          DateTime @default(now()) @db.Date
  calls         Int      @default(0)
  minutes       Float    @default(0)
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  toolCalls     Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([tenantId, date])
  @@index([tenantId, date])
}

// =====================================================
// Audit Log (tenant-scoped, append-only)
// =====================================================

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  actorType  String   @default("user")
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
}

// =====================================================
// Feature Flags (tenant-scoped overrides + global defaults)
// =====================================================

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String
  tenantId    String?  // null = global default
  enabled     Boolean  @default(false)
  rolloutPct  Int      @default(0)
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([key, tenantId])
  @@index([tenantId])
}

// =====================================================
// Phone Numbers (provisioned DIDs bound to a tenant/agent)
// Provider-neutral: `provider` selects Twilio / Telnyx / FreeSWITCH; the
// `providerExternalId` holds that provider's opaque ID (Twilio PN sid,
// Telnyx phone_number id, etc.) for future provisioning automation.
// =====================================================

model PhoneNumber {
  id                 String    @id @default(cuid())
  e164               String    @unique // e.g. +14155550123
  friendly           String?
  provider           String    @default("TWILIO") // TWILIO | TELNYX | FREESWITCH
  providerExternalId String?   @unique @map("twilioSid") // DB column kept as twilioSid for zero-migration rename

  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  instanceId String?
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  active     Boolean   @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@index([agentId])
}

// =====================================================
// Allowed Callers (per-tenant phone number allowlist)
// Empty list = open access (allow everyone). Non-empty list = strict allowlist;
// only listed callers connect, others hear a polite hangup. Optional fields
// (name/email/employeeId/snUserSysId) are passed to the voice pipeline so the
// agent can greet by name and SN tools can impersonate the right user.
// =====================================================

model AllowedCaller {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  phoneE164    String   // e.g. +14155550123 — match key
  name         String?
  email        String?
  employeeId   String?
  snUserSysId  String?  // 32-char ServiceNow sys_user sys_id for tool impersonation
  active       Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, phoneE164])
  @@index([tenantId, active])
}

// =====================================================
// Attachment Uploads (pending + completed file uploads from voice widget)
// Stored in DB (not in-memory) so state survives rolling deploys / restarts.
// =====================================================

model AttachmentUpload {
  id         String   @id @default(cuid())
  token      String   @unique
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sessionId  String   // SN conversation session sys_id
  agentId    String

  // Agent-requested target (optional). Resolved to sys_id at upload time.
  targetTable  String?
  targetNumber String?

  // Lifecycle. Pipeline polls for 'completed'. Set to 'cancelled' on stop().
  status     String   @default("pending")    // pending | completed | cancelled
  expiresAt  DateTime
  completedAt DateTime?

  // Populated on completion by the upload route
  fileName              String?
  mimeType              String?
  sizeBytes             Int?
  snAttachmentSysId     String?
  attachedTable         String?
  attachedSysId         String?
  attachedNumber        String?
  extractedText         String?  @db.Text
  extractedNote         String?
  extractedTruncated    Boolean?
  targetResolutionError String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([token])
  @@index([tenantId, status])
}

// =====================================================
// Waitlist (early-access signups for features like phone calls)
// =====================================================

model Waitlist {
  id        String   @id @default(cuid())
  email     String
  feature   String   @default("phone_calls")
  source    String?
  notes     String?
  createdAt DateTime @default(now())

  @@unique([email, feature])
  @@index([feature, createdAt])
}

// =====================================================
// Plan Definitions (DB-backed replacement for hardcoded PLANS)
// Keyed by the Plan enum value (FREE / PRO / PREMIUM).
// Legacy keys (STARTER / PRO_VOICE / BUSINESS / ENTERPRISE) remain in the
// Plan enum for existing tenants but are not surfaced in pricing UI; their
// PlanDefinition rows are marked active=false.
// =====================================================

model PlanDefinition {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  price            Int      @default(0)
  minutesPerMonth  Int      @default(0)
  concurrentLimit  Int      @default(1)
  maxAgents        Int      @default(1)
  maxInstances     Int      @default(1)
  overageRate      Float?
  oneTimeTrial     Boolean  @default(false)
  features         Json
  cta              String   @default("Get started")
  popular          Boolean  @default(false)
  displayOrder     Int      @default(100)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


// =====================================================
// SaaS Platform Configuration (singleton, id="default")
// =====================================================

model SaasConfig {
  id           String   @id @default("default")
  saasName     String   @default("ZeVox")
  tagline      String   @default("AI Voice Agents for ServiceNow")
  logoUrl      String?
  faviconUrl   String?
  primaryColor String   @default("#10b981")
  darkBg       String   @default("#000000")
  supportEmail String   @default("support@zevox.com")
  updatedAt    DateTime @updatedAt
}
